# Optional: front nginx (on another host or the VM itself) terminating TLS.
# When used, set in .env:  GITLAB_EXTERNAL_URL=https://gitlab.client.internal
# and publish GitLab on a non-80 port if nginx runs on the same VM (e.g. GITLAB_HTTP_PORT=8080).

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name gitlab.client.internal;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name gitlab.client.internal;

    ssl_certificate     /etc/nginx/ssl/gitlab.crt;   # internal CA / self-signed
    ssl_certificate_key /etc/nginx/ssl/gitlab.key;

    client_max_body_size 3000M;

    location / {
        proxy_set_header Host              $http_host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Ssl   on;
        proxy_set_header Upgrade           $http_upgrade;     # websockets (live UI updates, web terminal)
        proxy_set_header Connection        $connection_upgrade;
        proxy_http_version 1.1;
        proxy_redirect off;
        proxy_buffering off;
        proxy_connect_timeout 10m;
        proxy_send_timeout    10m;
        proxy_read_timeout    10m;
        proxy_pass http://IP-OF-GITLAB-VM:8080;           # = GITLAB_HTTP_PORT
    }
}
