# =====================================================================
#  GitLab offline stack - settings
#  Edit this file BEFORE running scripts/deploy.sh on the VM.
# =====================================================================

# --- Versions (keep runner major.minor == GitLab major.minor) ---------
# Changing these requires re-running scripts/prepare-images on an online machine.
GITLAB_VERSION=19.5.3-ce.0
RUNNER_VERSION=v19.5.3

# --- Addressing ---------------------------------------------------------
# Hostname (or IP) clients use to reach GitLab.
GITLAB_HOSTNAME=gitlab.client.internal

# Full URL users type in the browser. Rules:
#   * GitLab served directly on the VM:   http://gitlab.client.internal
#     (add :PORT if GITLAB_HTTP_PORT is not 80, e.g. http://10.0.0.5:8080)
#   * Behind an nginx/proxy doing TLS:     https://gitlab.client.internal
#     (the container still serves plain HTTP; the proxy terminates TLS)
GITLAB_EXTERNAL_URL=http://gitlab.client.internal

# Host port published for the web UI (container listens on 80).
GITLAB_HTTP_PORT=80

# Host port for git-over-SSH. Not 22, since the VM's own sshd uses it.
GITLAB_SSH_PORT=2222

# --- Storage / misc -----------------------------------------------------
# Where GitLab config, data, logs and runner config live (relative to this folder or absolute).
DATA_DIR=./data
TZ=UTC

# --- CI runner ----------------------------------------------------------
# Default image for jobs that don't specify one. Must be in EXTRA_IMAGES.
RUNNER_DEFAULT_IMAGE=alpine:3.22
# Set to true only if jobs need docker:dind (security trade-off).
RUNNER_PRIVILEGED=false

# Extra images to bundle for CI jobs (space separated). Used by prepare-images only.
EXTRA_IMAGES="alpine:3.22 ubuntu:24.04"
